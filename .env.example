# Copy this file to .env and replace the development-only password.
POSTGRES_DB=querivue
POSTGRES_USER=querivue
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_SSLMODE=disable
# Set this to a CA certificate path when the hosted provider requires one.
# POSTGRES_SSLROOTCERT=/path/to/ca-certificate.pem
