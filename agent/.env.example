# Querivue Agent Environment Variables
# Copy this file to .env and fill in your credentials

# Google AI / Gemini (F1/F2/F3 default provider)
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# NVIDIA (F2 reviewer fallback)
# Get your API key from: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here

# OpenRouter (alternative provider)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Cloudflare Workers AI (F3 config)
# Get your API token from: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# E2B Sandbox (for Python/SQL execution)
# Get your API key from: https://e2b.dev/
E2B_API_KEY=your_e2b_api_key_here

# Redis (for LangGraph checkpoints)
# Format: redis://[:password@]host:port/db
REDIS_URL=redis://localhost:6379/0

# Database (SQLite ledger - file path)
LEDGER_DB_PATH=./data/ledger.db

# Artifact storage
ARTIFACTS_DIR=./artifacts

# Trace output
TRACE_DIR=./traces

# Model Configuration (F1, F2, or F3)
MODEL_CONFIG=F1